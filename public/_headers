# Cloudflare static-asset headers; the SSR HTML gets its own in src/server.ts. Matching rules
# merge, so every asset gets nosniff on top of its cache rule.
/*
  X-Content-Type-Options: nosniff

# Bird assets are not content-hashed, so they are cached for a week and revalidated in the
# background rather than marked immutable.
/birds/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Vite's build output is content-hashed.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400
